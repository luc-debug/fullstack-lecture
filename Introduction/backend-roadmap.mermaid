    DesignPrinciples --> DI["Dependency Injection"]
    DesignPrinciples --> IOC["Inversion of Control"]

    %% Testing
    Testing --> Unit["Unit Testing"]
    Testing --> Integration["Integration Testing"]
    Testing --> E2E["End To End Testing"]

    %% Storage
    Storage --> Hardware["Storage Hardware"]
    Storage --> SQL
    Storage --> NoSQL

    Hardware --> RAM
    Hardware --> Disk

    SQL --> Select["Select Queries"]
    SQL --> Tables["Basic Table Definition"]
    SQL --> Columns["Column Types"]
    SQL --> Joins["Inner / Right / Left Joins"]
    SQL --> ACID["ACID Transaction"]


    REST --> RESTDesign["REST API Design"]
    REST --> Observability["API Observability"]
    REST --> MVC
    REST --> Security["Web Security"]

