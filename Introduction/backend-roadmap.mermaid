flowchart LR


    BackendRoadmap[Backend Roadmap] --> Fundamentals
    BackendRoadmap --> REST["REST APIs"]
    BackendRoadmap -->  AdvancedAPIDesign["Advanced API Design"]
    BackendRoadmap --> EDS["Event Driven Systems"]
    BackendRoadmap --> Arch["Architecture"]


    Fundamentals --> OOP
    Fundamentals --> Testing
    Fundamentals --> Storage
